# FAUNAL — local defaults are enough to run; nothing here is required to boot.

# SQLite engine used by lib/repo/* (dev + demo deployment).
# FAUNAL_DB=/absolute/path/to/faunal.db
# FAUNAL_PRIVATE_DIR=/absolute/path/to/private-documents

# Session cookie is httpOnly + SameSite=Lax; set a real secret in production
# when the Postgres/Supabase target is wired up (docs/ARCHITECTURE.md §4).
# FAUNAL_SESSION_SECRET=
# FAUNAL_SITE_URL=https://faunal.example.com

# Payment provider abstraction (FaunalPay is the local mock; a real PSP token
# vault is swapped here, never card numbers — payments keep token + last4).
# FAUNAL_PAYMENT_PROVIDER=faunal-pay
# FAUNAL_PAYOUT_DELAY_HOURS=48
